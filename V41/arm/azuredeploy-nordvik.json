{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "powerAutomateUrl": {
      "type": "securestring",
      "metadata": {
        "description": "HTTP POST-URL från Power Automate-flödet"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "namnSuffix": {
      "type": "string",
      "defaultValue": "02albper",
      "metadata": {
        "description": "Ditt användarnamn, används i globalt unika namn"
      }
    },
    "lopnummer": {
      "type": "string",
      "defaultValue": "01",
      "metadata": {
        "description": "Löpnummer, ändra för en extra miljö (test/demo)"
      }
    },
    "environment": {
      "type": "string",
      "defaultValue": "Production",
      "metadata": {
        "description": "Värde för taggen Environment"
      }
    },
    "storageSku": {
      "type": "string",
      "defaultValue": "Standard_ZRS",
      "allowedValues": [
        "Standard_LRS",
        "Standard_ZRS"
      ],
      "metadata": {
        "description": "Redundans för datalagringen. ZRS kräver zonstöd i regionen."
      }
    },
    "forvaltareGruppId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Objekt-ID för grp-nordvik-forvaltare (tom = hoppa över)"
      }
    },
    "ekonomiGruppId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Objekt-ID för grp-nordvik-ekonomi (tom = hoppa över)"
      }
    },
    "klientIp": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Din publika IP, släpps in genom lagringens brandvägg (för felsökning). Tom = ingen."
      }
    },
    "entraClientId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Klient-ID för app-registreringen (inloggning)"
      }
    },
    "entraTenantId": {
      "type": "string",
      "defaultValue": "[subscription().tenantId]"
    },
    "webbPlats": {
      "type": "string",
      "defaultValue": "[parameters('location')]",
      "metadata": {
        "description": "Region för Container Apps. Byt om huvudregionen saknar kapacitet."
      }
    },
    "statusNyckel": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "Delad nyckel som Power Automate använder mot /api/uppdatera-status"
      }
    }
  },
  "variables": {
    "tags": {
      "Company": "Nordvik Fastigheter AB",
      "Environment": "[parameters('environment')]",
      "CostCenter": "Forvaltning"
    },
    "dataStorage": "[concat('stnordvik', parameters('namnSuffix'), parameters('lopnummer'))]",
    "funcStorage": "[concat('stnordvikfn', parameters('namnSuffix'), parameters('lopnummer'))]",
    "funcApp": "[concat('func-nordvik-backend-', parameters('namnSuffix'), parameters('lopnummer'))]",
    "apiUrl": "[concat(variables('apiBase'), '/felanmalan')]",
    "indexHtmlTemplateBase64": "",
    "roleBlobContributor": "ba92f5b4-2d11-453d-a403-e96b0029c9fe",
    "roleBlobReader": "2a2b9908-6ea1-4ae2-8e65-a410df84e7d1",
    "roleReader": "acdd72a7-3385-48ef-bd42-f606fba81ae7",
    "roleBlobOwner": "b7e6dc6d-f1e8-4753-8033-0f276bb0955b",
    "roleQueueContributor": "974c5e8b-45b9-4653-ba55-5f855dd0fb88",
    "roleTableContributor": "0a9a7e1f-b9d0-4cc4-a60d-0319b160aaa3",
    "storageIpRules": "[if(empty(parameters('klientIp')), createArray(), createArray(createObject('value', parameters('klientIp'), 'action', 'Allow')))]",
    "indexHtml": "[replace(replace(replace(base64ToString(variables('indexHtmlTemplateBase64')), '__API_BASE__', variables('apiBase')), '__CLIENT_ID__', parameters('entraClientId')), '__TENANT_ID__', parameters('entraTenantId'))]",
    "apiBase": "[concat('https://', variables('funcApp'), '.azurewebsites.net/api')]"
  },
  "resources": [
    {
      "type": "Microsoft.Network/networkSecurityGroups",
      "apiVersion": "2023-05-01",
      "name": "nsg-nordvik",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "properties": {
        "securityRules": [
          {
            "name": "allow-out-dns",
            "properties": {
              "priority": 100,
              "direction": "Outbound",
              "access": "Allow",
              "protocol": "*",
              "sourceAddressPrefix": "*",
              "sourcePortRange": "*",
              "destinationAddressPrefix": "168.63.129.16",
              "destinationPortRange": "53"
            }
          },
          {
            "name": "allow-out-storage",
            "properties": {
              "priority": 110,
              "direction": "Outbound",
              "access": "Allow",
              "protocol": "Tcp",
              "sourceAddressPrefix": "*",
              "sourcePortRange": "*",
              "destinationAddressPrefix": "Storage",
              "destinationPortRange": "443"
            }
          },
          {
            "name": "allow-out-entra",
            "properties": {
              "priority": 120,
              "direction": "Outbound",
              "access": "Allow",
              "protocol": "Tcp",
              "sourceAddressPrefix": "*",
              "sourcePortRange": "*",
              "destinationAddressPrefix": "AzureActiveDirectory",
              "destinationPortRange": "443"
            }
          },
          {
            "name": "allow-out-https",
            "properties": {
              "priority": 130,
              "direction": "Outbound",
              "access": "Allow",
              "protocol": "Tcp",
              "sourceAddressPrefix": "*",
              "sourcePortRange": "*",
              "destinationAddressPrefix": "Internet",
              "destinationPortRange": "443"
            }
          },
          {
            "name": "deny-out-all",
            "properties": {
              "priority": 4000,
              "direction": "Outbound",
              "access": "Deny",
              "protocol": "*",
              "sourceAddressPrefix": "*",
              "sourcePortRange": "*",
              "destinationAddressPrefix": "*",
              "destinationPortRange": "*"
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2023-05-01",
      "name": "vnet-nordvik",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkSecurityGroups', 'nsg-nordvik')]"
      ],
      "properties": {
        "addressSpace": {
          "addressPrefixes": [
            "10.0.0.0/16"
          ]
        },
        "subnets": [
          {
            "name": "snet-nordvik-func",
            "properties": {
              "addressPrefix": "10.0.3.0/24",
              "networkSecurityGroup": {
                "id": "[resourceId('Microsoft.Network/networkSecurityGroups', 'nsg-nordvik')]"
              },
              "serviceEndpoints": [
                {
                  "service": "Microsoft.Storage"
                }
              ],
              "delegations": [
                {
                  "name": "flex-delegation",
                  "properties": {
                    "serviceName": "Microsoft.App/environments"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-01-01",
      "name": "[variables('dataStorage')]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "sku": {
        "name": "[parameters('storageSku')]"
      },
      "kind": "StorageV2",
      "properties": {
        "supportsHttpsTrafficOnly": true,
        "allowBlobPublicAccess": false,
        "allowSharedKeyAccess": false,
        "defaultToOAuthAuthentication": true,
        "minimumTlsVersion": "TLS1_2",
        "networkAcls": {
          "bypass": "AzureServices",
          "defaultAction": "Deny",
          "ipRules": "[variables('storageIpRules')]",
          "virtualNetworkRules": [
            {
              "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', 'vnet-nordvik', 'snet-nordvik-func')]",
              "action": "Allow"
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks', 'vnet-nordvik')]"
      ]
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2023-01-01",
      "name": "[concat(variables('dataStorage'), '/default/felanmalningar')]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('dataStorage'))]"
      ],
      "properties": {
        "publicAccess": "None"
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2023-01-01",
      "name": "[concat(variables('dataStorage'), '/default/dokument')]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('dataStorage'))]"
      ],
      "properties": {
        "publicAccess": "None"
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/managementPolicies",
      "apiVersion": "2023-01-01",
      "name": "[concat(variables('dataStorage'), '/default')]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('dataStorage'))]"
      ],
      "properties": {
        "policy": {
          "rules": [
            {
              "enabled": true,
              "name": "LifecycleNordvikBlobs",
              "type": "Lifecycle",
              "definition": {
                "actions": {
                  "baseBlob": {
                    "tierToCool": {
                      "daysAfterModificationGreaterThan": 90
                    }
                  }
                },
                "filters": {
                  "blobTypes": [
                    "blockBlob"
                  ]
                }
              }
            }
          ]
        }
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-01-01",
      "name": "[variables('funcStorage')]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "sku": {
        "name": "Standard_LRS"
      },
      "kind": "StorageV2",
      "properties": {
        "supportsHttpsTrafficOnly": true,
        "allowBlobPublicAccess": false,
        "minimumTlsVersion": "TLS1_2",
        "networkAcls": {
          "bypass": "AzureServices",
          "defaultAction": "Deny",
          "ipRules": "[variables('storageIpRules')]",
          "virtualNetworkRules": [
            {
              "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', 'vnet-nordvik', 'snet-nordvik-func')]",
              "action": "Allow"
            }
          ]
        },
        "allowSharedKeyAccess": false,
        "defaultToOAuthAuthentication": true
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks', 'vnet-nordvik')]"
      ]
    },
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2023-12-01",
      "name": "asp-nordvik-flex",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "sku": {
        "tier": "FlexConsumption",
        "name": "FC1"
      },
      "kind": "functionapp",
      "properties": {
        "reserved": true
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2023-12-01",
      "name": "[variables('funcApp')]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "kind": "functionapp,linux",
      "identity": {
        "type": "SystemAssigned"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', 'asp-nordvik-flex')]",
        "[resourceId('Microsoft.Storage/storageAccounts', variables('funcStorage'))]",
        "[resourceId('Microsoft.Storage/storageAccounts', variables('dataStorage'))]",
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices/containers', variables('funcStorage'), 'default', 'deploymentpackage')]",
        "[resourceId('Microsoft.Network/virtualNetworks', 'vnet-nordvik')]",
        "[resourceId('Microsoft.App/containerApps', 'ca-nordvik-web')]"
      ],
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', 'asp-nordvik-flex')]",
        "httpsOnly": true,
        "virtualNetworkSubnetId": "[resourceId('Microsoft.Network/virtualNetworks/subnets', 'vnet-nordvik', 'snet-nordvik-func')]",
        "functionAppConfig": {
          "deployment": {
            "storage": {
              "type": "blobContainer",
              "value": "[concat('https://', variables('funcStorage'), '.blob.core.windows.net/deploymentpackage')]",
              "authentication": {
                "type": "SystemAssignedIdentity"
              }
            }
          },
          "scaleAndConcurrency": {
            "maximumInstanceCount": 40,
            "instanceMemoryMB": 2048
          },
          "runtime": {
            "name": "python",
            "version": "3.11"
          }
        },
        "siteConfig": {
          "minTlsVersion": "1.2",
          "ftpsState": "Disabled",
          "cors": {
            "allowedOrigins": [
              "[concat('https://', reference(resourceId('Microsoft.App/containerApps', 'ca-nordvik-web')).configuration.ingress.fqdn)]"
            ]
          },
          "appSettings": [
            {
              "name": "AzureWebJobsStorage__accountName",
              "value": "[variables('funcStorage')]"
            },
            {
              "name": "POWER_AUTOMATE_URL",
              "value": "[parameters('powerAutomateUrl')]"
            },
            {
              "name": "DATA_STORAGE_ACCOUNT_URL",
              "value": "[concat('https://', variables('dataStorage'), '.blob.core.windows.net')]"
            },
            {
              "name": "ENTRA_TENANT_ID",
              "value": "[parameters('entraTenantId')]"
            },
            {
              "name": "ENTRA_CLIENT_ID",
              "value": "[parameters('entraClientId')]"
            },
            {
              "name": "DATA_TABLE_ENDPOINT",
              "value": "[concat('https://', variables('dataStorage'), '.table.core.windows.net')]"
            },
            {
              "name": "STATUS_API_KEY",
              "value": "[parameters('statusNyckel')]"
            }
          ]
        }
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(resourceId('Microsoft.Storage/storageAccounts', variables('dataStorage')), resourceId('Microsoft.Web/sites', variables('funcApp')), variables('roleBlobContributor'))]",
      "scope": "[resourceId('Microsoft.Storage/storageAccounts', variables('dataStorage'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('dataStorage'))]",
        "[resourceId('Microsoft.Web/sites', variables('funcApp'))]"
      ],
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('roleBlobContributor'))]",
        "principalId": "[reference(resourceId('Microsoft.Web/sites', variables('funcApp')), '2023-12-01', 'Full').identity.principalId]",
        "principalType": "ServicePrincipal"
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "condition": "[not(empty(parameters('forvaltareGruppId')))]",
      "name": "[guid(resourceId('Microsoft.Storage/storageAccounts', variables('dataStorage')), parameters('forvaltareGruppId'), variables('roleBlobContributor'))]",
      "scope": "[resourceId('Microsoft.Storage/storageAccounts', variables('dataStorage'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('dataStorage'))]"
      ],
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('roleBlobContributor'))]",
        "principalId": "[parameters('forvaltareGruppId')]",
        "principalType": "Group"
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "condition": "[not(empty(parameters('ekonomiGruppId')))]",
      "name": "[guid(resourceGroup().id, parameters('ekonomiGruppId'), variables('roleReader'))]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('roleReader'))]",
        "principalId": "[parameters('ekonomiGruppId')]",
        "principalType": "Group"
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "condition": "[not(empty(parameters('ekonomiGruppId')))]",
      "name": "[guid(resourceId('Microsoft.Storage/storageAccounts', variables('dataStorage')), parameters('ekonomiGruppId'), variables('roleBlobReader'))]",
      "scope": "[resourceId('Microsoft.Storage/storageAccounts', variables('dataStorage'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('dataStorage'))]"
      ],
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('roleBlobReader'))]",
        "principalId": "[parameters('ekonomiGruppId')]",
        "principalType": "Group"
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2023-01-01",
      "name": "[concat(variables('funcStorage'), '/default/deploymentpackage')]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('funcStorage'))]"
      ],
      "properties": {
        "publicAccess": "None"
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(resourceId('Microsoft.Storage/storageAccounts', variables('funcStorage')), resourceId('Microsoft.Web/sites', variables('funcApp')), variables('roleBlobOwner'))]",
      "scope": "[resourceId('Microsoft.Storage/storageAccounts', variables('funcStorage'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('funcStorage'))]",
        "[resourceId('Microsoft.Web/sites', variables('funcApp'))]"
      ],
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('roleBlobOwner'))]",
        "principalId": "[reference(resourceId('Microsoft.Web/sites', variables('funcApp')), '2023-12-01', 'Full').identity.principalId]",
        "principalType": "ServicePrincipal"
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(resourceId('Microsoft.Storage/storageAccounts', variables('funcStorage')), resourceId('Microsoft.Web/sites', variables('funcApp')), variables('roleQueueContributor'))]",
      "scope": "[resourceId('Microsoft.Storage/storageAccounts', variables('funcStorage'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('funcStorage'))]",
        "[resourceId('Microsoft.Web/sites', variables('funcApp'))]"
      ],
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('roleQueueContributor'))]",
        "principalId": "[reference(resourceId('Microsoft.Web/sites', variables('funcApp')), '2023-12-01', 'Full').identity.principalId]",
        "principalType": "ServicePrincipal"
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(resourceId('Microsoft.Storage/storageAccounts', variables('funcStorage')), resourceId('Microsoft.Web/sites', variables('funcApp')), variables('roleTableContributor'))]",
      "scope": "[resourceId('Microsoft.Storage/storageAccounts', variables('funcStorage'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('funcStorage'))]",
        "[resourceId('Microsoft.Web/sites', variables('funcApp'))]"
      ],
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('roleTableContributor'))]",
        "principalId": "[reference(resourceId('Microsoft.Web/sites', variables('funcApp')), '2023-12-01', 'Full').identity.principalId]",
        "principalType": "ServicePrincipal"
      }
    },
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2022-10-01",
      "name": "log-nordvik",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "properties": {
        "sku": {
          "name": "PerGB2018"
        },
        "retentionInDays": 30
      }
    },
    {
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2024-03-01",
      "name": "cae-nordvik",
      "location": "[parameters('webbPlats')]",
      "tags": "[variables('tags')]",
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', 'log-nordvik')]"
      ],
      "properties": {
        "appLogsConfiguration": {
          "destination": "log-analytics",
          "logAnalyticsConfiguration": {
            "customerId": "[reference(resourceId('Microsoft.OperationalInsights/workspaces', 'log-nordvik'), '2022-10-01').customerId]",
            "sharedKey": "[listKeys(resourceId('Microsoft.OperationalInsights/workspaces', 'log-nordvik'), '2022-10-01').primarySharedKey]"
          }
        }
      }
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "ca-nordvik-web",
      "location": "[parameters('webbPlats')]",
      "tags": "[variables('tags')]",
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', 'cae-nordvik')]"
      ],
      "properties": {
        "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', 'cae-nordvik')]",
        "configuration": {
          "ingress": {
            "external": true,
            "targetPort": 80,
            "transport": "auto",
            "allowInsecure": false
          },
          "secrets": [
            {
              "name": "indexhtml",
              "value": "[variables('indexHtml')]"
            }
          ]
        },
        "template": {
          "containers": [
            {
              "name": "web",
              "image": "nginx:alpine",
              "resources": {
                "cpu": 0.25,
                "memory": "0.5Gi"
              },
              "volumeMounts": [
                {
                  "volumeName": "html",
                  "mountPath": "/usr/share/nginx/html"
                }
              ]
            }
          ],
          "volumes": [
            {
              "name": "html",
              "storageType": "Secret",
              "secrets": [
                {
                  "secretRef": "indexhtml",
                  "path": "index.html"
                }
              ]
            }
          ],
          "scale": {
            "minReplicas": 0,
            "maxReplicas": 5,
            "rules": [
              {
                "name": "kontorstid",
                "custom": {
                  "type": "cron",
                  "metadata": {
                    "timezone": "Europe/Stockholm",
                    "start": "0 6 * * *",
                    "end": "0 23 * * *",
                    "desiredReplicas": "2"
                  }
                }
              },
              {
                "name": "http-belastning",
                "http": {
                  "metadata": {
                    "concurrentRequests": "50"
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/tableServices/tables",
      "apiVersion": "2023-01-01",
      "name": "[concat(variables('dataStorage'), '/default/felanmalningar')]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('dataStorage'))]"
      ]
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(resourceId('Microsoft.Storage/storageAccounts', variables('dataStorage')), resourceId('Microsoft.Web/sites', variables('funcApp')), variables('roleTableContributor'))]",
      "scope": "[resourceId('Microsoft.Storage/storageAccounts', variables('dataStorage'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('dataStorage'))]",
        "[resourceId('Microsoft.Web/sites', variables('funcApp'))]"
      ],
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('roleTableContributor'))]",
        "principalId": "[reference(resourceId('Microsoft.Web/sites', variables('funcApp')), '2023-12-01', 'Full').identity.principalId]",
        "principalType": "ServicePrincipal"
      }
    }
  ],
  "outputs": {
    "storageAccountName": {
      "type": "string",
      "value": "[variables('dataStorage')]"
    },
    "functionAppName": {
      "type": "string",
      "value": "[variables('funcApp')]"
    },
    "webUrl": {
      "type": "string",
      "value": "[concat('https://', reference(resourceId('Microsoft.App/containerApps', 'ca-nordvik-web')).configuration.ingress.fqdn)]"
    },
    "backendUrl": {
      "type": "string",
      "value": "[variables('apiUrl')]"
    }
  }
}